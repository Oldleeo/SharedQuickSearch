// 共享速搜 · 安装预设
// 把这个文件和安装包（SharedQuickSearch-Setup.exe）放在同一个文件夹里，
// 同事双击安装后，首次引导会自动填好下面这些，点“下一步”就行。每一项都可以删掉不写。
// 注意：JSON 里的反斜杠要写两遍（\\NAS\设计部 写成 "\\\\NAS\\设计部"）。
{
  // 要索引的共享盘目录
  "indexRoots": [
    "\\\\NAS\\设计部",
    "\\\\NAS\\产品图"
  ],

  // 不录入的文件夹（回收站、群晖缩略图这些软件会自动排除，不用写）
  "excludedPaths": [
    "\\\\NAS\\设计部\\归档2019"
  ],

  // 全组共用缓存（缩略图 + 扫好的索引）默认开着：软件会自动在共享盘上找隐藏的 .共享速搜缓存，
  // 没有就在共享根目录新建一个（那里不能写就往下一层找）。一般不用写下面两行。
  // 想指定位置就写 teamCacheFolder；全组权限不一样、不想共用，就写 "teamCacheMode": "off"。
  // "teamCacheFolder": "\\\\NAS\\设计部",
  // "teamCacheMode": "off",

  // 给权限比别人大的人（老板、管理员）单独准备的安装包里写 false：只用同事的索引，不把自己的发出去。
  // "publishSharedIndex": false,

  // 自建的更新源（GitHub 在公司网络里慢时用）。不写就用 GitHub。
  // "updateFeed": "\\\\NAS\\软件\\共享速搜\\update.json",

  "autoStart": true,
  "clipboardPrefill": true,
  "doubleCtrlSummon": false
}
