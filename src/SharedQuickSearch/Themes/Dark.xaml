<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色：近黑但不纯黑，层级靠亮度差而不是描边。键名与 Light.xaml 完全一致。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D0E11"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#16171B"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1B1C21"/>
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#1F2026"/>
    <SolidColorBrush x:Key="SearchBrush" Color="#1A1B20"/>

    <SolidColorBrush x:Key="ControlBrush" Color="#1E1F25"/>
    <SolidColorBrush x:Key="ControlAltBrush" Color="#202228"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1F2127"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E2440"/>
    <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#34407A"/>

    <SolidColorBrush x:Key="StrokeBrush" Color="#25272E"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#33363E"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEDF0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A5B1"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#686D79"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#6F86FF"/>
    <SolidColorBrush x:Key="AccentHoverOverlayBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D2340"/>
    <SolidColorBrush x:Key="AccentRingBrush" Color="#556F86FF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#3CCB7F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F0B13E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F06262"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2E1B1D"/>

    <SolidColorBrush x:Key="ToastBrush" Color="#F2ECEDF0"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="#14161B"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#E616171B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3D45"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5A5E68"/>
    <SolidColorBrush x:Key="KeycapBrush" Color="#202228"/>
    <SolidColorBrush x:Key="KeycapStrokeBrush" Color="#33363E"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#3A3D45"/>

    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E81123"/>

    <!-- 聚光面板 -->
    <Color x:Key="SpotlightPanelColor">#16171B</Color>
    <SolidColorBrush x:Key="SpotlightPanelBrush" Color="#F716171B"/>
    <SolidColorBrush x:Key="SpotlightStrokeBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SpotlightTileBrush" Color="#1F2127"/>
    <SolidColorBrush x:Key="SpotlightScrimBrush" Color="#D8101114"/>
</ResourceDictionary>
