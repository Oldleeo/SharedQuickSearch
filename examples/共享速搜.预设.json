// 共享速搜 · 安装预设
// 把这个文件和安装包（SharedQuickSearch-Setup.exe）放在同一个文件夹里，
// 同事双击安装后，首次引导会自动填好下面这些，点“下一步”就行。每一项都可以删掉不写。
// 注意：JSON 里的反斜杠要写两遍（\\NAS\设计部 写成 "\\\\NAS\\设计部"）。
{
  // 要索引的共享盘目录
  "indexRoots": [
    "\\\\NAS\\设计部",
    "\\\\NAS\\产品图"
  ],

  // 不录入的文件夹（回收站、群晖缩略图这些软件会自动排除，不用写）
  "excludedPaths": [
    "\\\\NAS\\设计部\\归档2019"
  ],

  // 全组共用缩略图缓存：共享盘上的一个位置，软件会在里面建隐藏的 .共享速搜缓存 文件夹。
  // 大家要对这个位置有写权限；没有写权限的人只读别人生成好的。不想共用就删掉这一行。
  "teamCacheFolder": "\\\\NAS\\设计部",

  // 自建的更新源（GitHub 在公司网络里慢时用）。不写就用 GitHub。
  // "updateFeed": "\\\\NAS\\软件\\共享速搜\\update.json",

  "autoStart": true,
  "clipboardPrefill": true,
  "doubleCtrlSummon": false
}
