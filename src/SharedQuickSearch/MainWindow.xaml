<Window x:Class="SharedQuickSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharedQuickSearch"
        Title="共享速搜" Icon="Assets/共享速搜.ico" Width="1320" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Style="{StaticResource WindowBase}"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder">
        <Grid x:Name="RootContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏：品牌 / 搜索 / 窗口按钮 ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="7" ClipToBounds="True">
                        <Image RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source><BitmapImage UriSource="Assets/共享速搜-icon.png" DecodePixelWidth="64"/></Image.Source>
                        </Image>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="共享速搜" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IndexSummaryText" Text="尚未建立索引" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 搜索框 -->
                <Grid Grid.Column="1" MaxWidth="720" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="SearchRing" CornerRadius="14" Margin="-4" BorderThickness="4" BorderBrush="{DynamicResource AccentRingBrush}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="SearchShell" Height="40" CornerRadius="11" Background="{DynamicResource SearchBrush}" BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                            Cursor="IBeam" MouseLeftButtonDown="SearchShell_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SearchIcon" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索 SKU、文件名或路径" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="14" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     GotKeyboardFocus="SearchBox_FocusChanged" LostKeyboardFocus="SearchBox_FocusChanged"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button x:Name="ClearSearchButton" Style="{StaticResource SmallIconButton}" Content="&#xE711;" FontSize="10" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="清空 (Esc)" Cursor="Hand"/>
                                <Border x:Name="HotkeyKeycap" Style="{StaticResource Keycap}" Margin="4,0,2,0">
                                    <TextBlock x:Name="HotkeyKeycapText" Text="Ctrl Alt Space" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE706;" Margin="0,12,2,0" Click="ThemeButton_Click" ToolTip="切换主题" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE713;" Margin="0,12,10,0" Click="MoreButton_Click" ToolTip="设置与更多" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="设置…" Click="SettingsButton_Click" InputGestureText="Ctrl+,"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE713;"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="刷新索引" Click="RebuildButton_Click" InputGestureText="F5"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE72C;"/></MenuItem.Icon></MenuItem>
                                <Separator/>
                                <MenuItem Header="关于共享速搜" Click="AboutMenu_Click"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;"/></MenuItem.Icon></MenuItem>
                                <MenuItem Header="隐私政策" Click="PrivacyMenu_Click"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xEA18;"/></MenuItem.Icon></MenuItem>
                                <Separator/>
                                <MenuItem Header="退出" Click="ExitMenu_Click"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7E8;"/></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeWindow_Click" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="MaximizeWindow_Click" ToolTip="最大化"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>

            <!-- ============ 工具条：分类胶囊 / 排序 / 视图 ============ -->
            <Grid Grid.Row="1" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ChipAll" Style="{StaticResource Chip}" GroupName="Category" Tag="All" IsChecked="True" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="全部"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Category" Tag="Images" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="图片"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Category" Tag="Design" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="PSD · AI"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Category" Tag="Documents" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="文档"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Category" Tag="Videos" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE714;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="视频"/></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Category" Tag="Folders" Checked="Category_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="文件夹"/></StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultSummaryText" Text="0 项" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ComboBox x:Name="SortCombo" Width="118" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged" ToolTip="排序">
                        <ComboBoxItem Content="相关度" Tag="Relevance"/>
                        <ComboBoxItem Content="名称" Tag="Name"/>
                        <ComboBoxItem Content="修改时间" Tag="Modified"/>
                        <ComboBoxItem Content="大小" Tag="Size"/>
                        <ComboBoxItem Content="类型" Tag="Type"/>
                        <ComboBoxItem Content="路径" Tag="Path"/>
                    </ComboBox>
                    <Border CornerRadius="9" Background="{DynamicResource ControlAltBrush}" Padding="3" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="GridViewToggle" Style="{StaticResource Segment}" GroupName="View" Content="&#xF0E2;" Checked="ViewToggle_Checked" ToolTip="缩略图"/>
                            <RadioButton x:Name="ListViewToggle" Style="{StaticResource Segment}" GroupName="View" Content="&#xE8FD;" Checked="ViewToggle_Checked" ToolTip="详细列表"/>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="PreviewToggleButton" Style="{StaticResource IconToggle}" Content="&#xE8A0;" Margin="8,0,0,0" Click="PreviewToggle_Click" ToolTip="预览窗格"/>
                    <Button x:Name="RebuildButton" Margin="8,0,0,0" Click="RebuildButton_Click" Height="32" Padding="12,0" ToolTip="重新扫描索引目录 (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RebuildGlyph" Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="RebuildGlyphRotate"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="RebuildText" Text="刷新索引"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ 内容：结果卡片 | 预览卡片 ============ -->
            <Grid Grid.Row="2" Margin="18,4,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="380" MinWidth="0" MaxWidth="760"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardShadow}"/>
                <Border x:Name="ResultsCard" Style="{StaticResource Card}">
                    <Grid>
                        <ProgressBar x:Name="IndexProgressBar" VerticalAlignment="Top" Margin="14,0" Visibility="Collapsed" Minimum="0" Maximum="100"/>

                        <Grid x:Name="ResultsHost">
                            <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0" Padding="6,4,6,6" Visibility="Collapsed"
                                      ItemContainerStyle="{StaticResource ResultRow}" SelectionMode="Extended"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                      SelectionChanged="ResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="Results_PreviewMouseRightButtonDown" ScrollViewer.ScrollChanged="Results_ScrollChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="True">
                                        <GridViewColumn Header="名称" Width="330">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource ThumbBackgroundBrush}" Margin="0,0,10,0">
                                                            <Grid>
                                                                <TextBlock x:Name="Glyph" Text="{Binding IconGlyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding TypeBrush}"/>
                                                                <Image Source="{Binding Thumbnail, NotifyOnTargetUpdated=True}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.Triggers>
                                                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Image.Triggers>
                                                                </Image>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="Medium" ToolTip="{Binding FullPath}"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="位置" Width="360">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding ParentPath}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ParentPath}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="大小" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="修改时间" Width="136">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding ModifiedLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="类型" Width="104">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding TypeBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="分辨率" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding ResolutionLabel}" Foreground="{DynamicResource TextTertiaryBrush}"/></DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu><ContextMenu>
                                    <MenuItem Header="打开" Click="OpenMenu_Click" InputGestureText="Enter"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="打开所在位置" Click="RevealMenu_Click" InputGestureText="Ctrl+Enter"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE838;"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem Header="复制文件" Click="CopyItemMenu_Click" InputGestureText="Ctrl+Shift+C"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="复制完整路径" Click="CopyPathMenu_Click" InputGestureText="Ctrl+C"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE71B;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="复制名称" Click="CopyNameMenu_Click"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8AC;"/></MenuItem.Icon></MenuItem>
                                </ContextMenu></ListView.ContextMenu>
                            </ListView>

                            <ListBox x:Name="LargeResultsList" Background="Transparent" BorderThickness="0" Padding="8" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource GridCard}"
                                     SelectionChanged="LargeResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                                     PreviewMouseRightButtonDown="Results_PreviewMouseRightButtonDown" ScrollViewer.ScrollChanged="Results_ScrollChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Border Height="128" CornerRadius="8" Background="{DynamicResource ThumbBackgroundBrush}">
                                                <Grid>
                                                    <TextBlock x:Name="Glyph" Text="{Binding IconGlyph}" Style="{StaticResource Icon}" FontSize="34" Foreground="{Binding TypeBrush}" Opacity="0.85"/>
                                                    <Image Source="{Binding Thumbnail, NotifyOnTargetUpdated=True}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                                                            </EventTrigger>
                                                        </Image.Triggers>
                                                    </Image>
                                                    <Border x:Name="Badge" CornerRadius="5" Background="{Binding TypeBrush}" Padding="6,2" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ExtensionLabel}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="3,9,3,0" FontSize="12" FontWeight="Medium" LineHeight="17" MaxHeight="34"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                            <TextBlock Text="{Binding CardMeta}" Margin="3,3,3,1" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True"><Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu><ContextMenu>
                                    <MenuItem Header="打开" Click="OpenMenu_Click" InputGestureText="Enter"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="打开所在位置" Click="RevealMenu_Click" InputGestureText="Ctrl+Enter"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE838;"/></MenuItem.Icon></MenuItem>
                                    <Separator/>
                                    <MenuItem Header="复制文件" Click="CopyItemMenu_Click" InputGestureText="Ctrl+Shift+C"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="复制完整路径" Click="CopyPathMenu_Click" InputGestureText="Ctrl+C"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE71B;"/></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="复制名称" Click="CopyNameMenu_Click"><MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8AC;"/></MenuItem.Icon></MenuItem>
                                </ContextMenu></ListBox.ContextMenu>
                            </ListBox>
                        </Grid>

                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="24">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="没有结果" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock x:Name="EmptyDescription" Text="输入 SKU 或文件名开始搜索" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" Margin="0,6,0,0" LineHeight="19"/>
                            <Button x:Name="EmptyActionButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,0" Height="34" Visibility="Collapsed" Click="EmptyAction_Click"/>
                        </StackPanel>

                        <!-- Toast -->
                        <Border x:Name="Toast" CornerRadius="10" Background="{DynamicResource ToastBrush}" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                                IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                            <Border.RenderTransform><TranslateTransform x:Name="ToastShift"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000"/></Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToastIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource ToastTextBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ToastText" Text="已复制" Foreground="{DynamicResource ToastTextBrush}" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="PreviewSplitter_DragCompleted"/>

                <!-- 预览卡片 -->
                <Grid x:Name="PreviewPane" Grid.Column="2">
                    <Border Style="{StaticResource CardShadow}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46"/>
                                <RowDefinition Height="*" MinHeight="160"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="16,0,10,0">
                                <TextBlock Text="预览" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE76B;" Click="PreviousPreview_Click" ToolTip="上一个"/>
                                    <Button Style="{StaticResource SmallIconButton}" Content="&#xE76C;" Click="NextPreview_Click" ToolTip="下一个" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="12,0" CornerRadius="10" Background="{DynamicResource ThumbBackgroundBrush}" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed"
                                                  MediaFailed="PreviewVideo_MediaFailed" MediaOpened="PreviewVideo_MediaOpened" MediaEnded="PreviewVideo_MediaEnded"/>
                                    <ScrollViewer x:Name="PreviewTextScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                        <TextBlock x:Name="PreviewText" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                    <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                        <TextBlock x:Name="PreviewGlyph" Text="&#xEB9F;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="PreviewMessage" Text="选择一个文件查看预览" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="19"/>
                                    </StackPanel>
                                    <Border x:Name="VideoControlPanel" VerticalAlignment="Bottom" Margin="10" CornerRadius="10" Padding="6,4,12,4" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Button x:Name="VideoPlayButton" Style="{StaticResource SmallIconButton}" Content="&#xE768;" Click="VideoPlayButton_Click" ToolTip="播放 / 暂停 (空格)"/>
                                            <Slider x:Name="VideoPositionSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0" ValueChanged="VideoPositionSlider_ValueChanged"/>
                                            <TextBlock x:Name="VideoTimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="PreviewInfo" Grid.Row="2" Margin="18,16,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PreviewTypeBadge" CornerRadius="5" Padding="7,2" Background="{DynamicResource ControlAltBrush}">
                                        <TextBlock x:Name="PreviewTypeText" Text="未选择" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <Border x:Name="PreviewOfflineChip" CornerRadius="5" Padding="7,2" Margin="6,0,0,0" Background="{DynamicResource DangerSoftBrush}" Visibility="Collapsed">
                                        <TextBlock Text="离线快照" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PreviewName" Text="未选择文件" Margin="0,10,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" LineHeight="21"/>
                                <TextBox x:Name="PreviewPath" Style="{StaticResource SelectableText}" Text="—" Margin="0,5,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" MaxHeight="34"/>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                                    <TextBlock Text="大小" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewSize" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="修改时间" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewModified" Grid.Row="1" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="分辨率" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewResolution" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center"/>
                                </Grid>

                                <Button x:Name="RelatedSkuButton" HorizontalAlignment="Left" Margin="0,12,0,0" Height="28" Padding="10,0" Visibility="Collapsed" Click="RelatedSku_Click" local:Ui.CornerRadius="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="RelatedSkuText" Text="查看同 SKU"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="3" Margin="18,16,18,18">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="OpenButton" Grid.ColumnSpan="5" Style="{StaticResource PrimaryButton}" Height="38" IsEnabled="False" Click="OpenButton_Click" local:Ui.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="打开"/></StackPanel>
                                </Button>
                                <Button x:Name="CopyItemButton" Grid.Row="2" Height="34" IsEnabled="False" Click="CopyItemButton_Click" ToolTip="把文件放进剪贴板，可直接粘贴到聊天或文件夹">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="复制文件"/></StackPanel>
                                </Button>
                                <Button x:Name="RevealButton" Grid.Row="2" Grid.Column="2" Height="34" IsEnabled="False" Click="RevealButton_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="所在位置"/></StackPanel>
                                </Button>
                                <Button x:Name="CopyPathButton" Grid.Row="2" Grid.Column="4" Width="34" Height="34" Padding="0" IsEnabled="False" Click="CopyPathButton_Click" ToolTip="复制完整路径 (Ctrl+C)"
                                        FontFamily="{StaticResource IconFont}" Content="&#xE71B;" FontSize="13" FontWeight="Normal"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Grid Grid.Row="3" Margin="22,0,22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备就绪" Margin="9,0,16,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PrefetchText" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="IndexEtaText" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Text="↑↓ 选择" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Enter 打开" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Ctrl+C 复制路径" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
