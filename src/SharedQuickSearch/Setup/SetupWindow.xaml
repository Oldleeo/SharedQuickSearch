<Window x:Class="SharedQuickSearch.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装共享速搜" Icon="/Assets/共享速搜.ico" Style="{StaticResource FlowWindow}" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Stage" Margin="20,14,20,30">
        <Border Style="{StaticResource FlowShadow}"/>
        <Border Style="{StaticResource FlowPanel}">
            <Grid Width="758" Height="542">
                <Grid.Clip><RectangleGeometry Rect="0,0,758,542" RadiusX="20" RadiusY="20"/></Grid.Clip>

                <!-- 背景里缓慢漂移的一团强调色光晕：只在欢迎页和完成页显示 -->
                <Canvas x:Name="Glow" IsHitTestVisible="False" Opacity="0">
                    <Ellipse Width="520" Height="520" Canvas.Left="360" Canvas.Top="-220">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#402457E6"/>
                                <GradientStop Offset="0.55" Color="#122457E6"/>
                                <GradientStop Offset="1" Color="#002457E6"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform x:Name="GlowShift"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="78"/>
                    </Grid.RowDefinitions>

                    <!-- 顶栏：按住拖动窗口 -->
                    <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="24,0,14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/共享速搜-icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="共享速搜" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeaderMode" Text="安装" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="36" Height="36" Content="&#xE8BB;" FontSize="10"
                                Click="CloseButton_Click" ToolTip="关闭" Focusable="False"/>
                    </Grid>

                    <Grid x:Name="Pages" Grid.Row="1" Margin="52,4,52,0">

                        <!-- 欢迎 -->
                        <Grid x:Name="PageWelcome">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,24">
                                <Grid HorizontalAlignment="Left" Width="76" Height="76" Margin="0,0,0,26">
                                    <Border CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                                        <Border.RenderTransform><ScaleTransform x:Name="IconPulse" CenterX="38" CenterY="38"/></Border.RenderTransform>
                                    </Border>
                                    <Image Source="/Assets/共享速搜-icon.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <TextBlock x:Name="WelcomeEyebrow" Text="版本 1.11.0" Style="{StaticResource FlowEyebrow}"/>
                                <TextBlock Text="共享盘里的素材，输入就找到。" Style="{StaticResource FlowTitle}" FontSize="30"/>
                                <TextBlock Style="{StaticResource FlowLead}" MaxWidth="560" HorizontalAlignment="Left"
                                           Text="把共享盘建成本机索引，按 SKU、文件名或拼音首字母秒搜，缩略图直接看，拖出去就是复制一份。"/>
                                <UniformGrid Columns="3" Margin="0,30,0,0" HorizontalAlignment="Left" Width="600">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SpotlightTileBrush}"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="毫秒级搜索" Style="{StaticResource FlowItemTitle}" FontSize="12.5"/><TextBlock Text="20 万个文件也不卡" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SpotlightTileBrush}"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="拖出即复制" Style="{StaticResource FlowItemTitle}" FontSize="12.5"/><TextBlock Text="原文件永远不动" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SpotlightTileBrush}"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/></Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="数据留在本机" Style="{StaticResource FlowItemTitle}" FontSize="12.5"/><TextBlock Text="不联网、不上传" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                                <Border x:Name="UpgradeNote" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Padding="14,10" Margin="0,30,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="UpgradeNoteText" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 安装位置 -->
                        <Grid x:Name="PageLocation" Visibility="Collapsed">
                            <StackPanel x:Name="LocationContent" VerticalAlignment="Top" Margin="0,22,0,0">
                                <TextBlock Text="第 1 步 · 共 2 步" Style="{StaticResource FlowEyebrow}"/>
                                <TextBlock Text="装到哪里" Style="{StaticResource FlowTitle}"/>
                                <TextBlock Style="{StaticResource FlowLead}" Text="默认装在你自己的用户目录里，不需要管理员权限，也不影响这台电脑上的其他用户。一般不用改。"/>
                                <Border Style="{StaticResource FlowRow}" Margin="0,26,0,0" Padding="16,6,6,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="LocationBox" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="13" Margin="12,0,10,0" VerticalContentAlignment="Center"
                                                 FontFamily="{StaticResource UiFont}" TextChanged="LocationBox_TextChanged"/>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="更改…" Height="34" Padding="14,0" Click="BrowseLocation_Click" Focusable="False"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                                    <Ellipse x:Name="SpaceDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpaceText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LocationWarning" Style="{StaticResource FlowItemHint}" Foreground="{DynamicResource WarningBrush}" Margin="2,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- 选项 -->
                        <Grid x:Name="PageOptions" Visibility="Collapsed">
                            <StackPanel x:Name="OptionsContent" VerticalAlignment="Top" Margin="0,22,0,0">
                                <TextBlock Text="第 2 步 · 共 2 步" Style="{StaticResource FlowEyebrow}"/>
                                <TextBlock Text="快捷方式" Style="{StaticResource FlowTitle}"/>
                                <TextBlock Style="{StaticResource FlowLead}" Text="平时用快捷键呼出，快捷方式只是第一次打开、或者忘了快捷键时用。"/>
                                <Border Style="{StaticResource FlowRow}" Margin="0,24,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="添加到开始菜单" Style="{StaticResource FlowItemTitle}"/><TextBlock Text="在开始菜单里搜“共享速搜”就能找到。" Style="{StaticResource FlowItemHint}"/></StackPanel>
                                        <CheckBox x:Name="StartMenuCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FlowRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="在桌面放一个快捷方式" Style="{StaticResource FlowItemTitle}"/><TextBlock Text="不想桌面多一个图标就关掉。" Style="{StaticResource FlowItemHint}"/></StackPanel>
                                        <CheckBox x:Name="DesktopCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource FlowRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="装好后立即打开" Style="{StaticResource FlowItemTitle}"/><TextBlock Text="第一次打开会带你添加共享盘目录，大约一分钟。" Style="{StaticResource FlowItemHint}"/></StackPanel>
                                        <CheckBox x:Name="LaunchCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 卸载确认 -->
                        <Grid x:Name="PageUninstall" Visibility="Collapsed">
                            <StackPanel x:Name="UninstallContent" VerticalAlignment="Top" Margin="0,22,0,0">
                                <TextBlock Text="卸载" Style="{StaticResource FlowEyebrow}" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock x:Name="UninstallTitle" Text="确定要卸载共享速搜吗？" Style="{StaticResource FlowTitle}"/>
                                <TextBlock x:Name="UninstallLead" Style="{StaticResource FlowLead}" Text="会删除这台电脑上的程序文件、快捷方式和开机启动项。共享盘上的文件一个都不会碰。"/>
                                <Border Style="{StaticResource FlowRow}" Margin="0,26,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="RemoveDataTitle" Text="同时删除我的设置、索引和缩略图缓存" Style="{StaticResource FlowItemTitle}"/>
                                            <TextBlock Text="保留的话，以后重新安装可以直接用，不用重新扫描共享盘。" Style="{StaticResource FlowItemHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RemoveDataCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="False" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="UninstallLocation" Style="{StaticResource Caption}" Margin="2,6,0,0" FontFamily="{StaticResource UiFont}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 进度（安装和卸载共用） -->
                        <Grid x:Name="PageProgress" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Top" Margin="0,22,0,0">
                                <TextBlock x:Name="ProgressEyebrow" Text="正在安装" Style="{StaticResource FlowEyebrow}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProgressTitle" Text="复制程序文件" Style="{StaticResource FlowTitle}"/>
                                    <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="0%" FontSize="27" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom"/>
                                </Grid>
                                <!-- 进度条：填充只做横向缩放，上面一道光扫过 -->
                                <Grid Height="8" Margin="0,22,0,0" ClipToBounds="True">
                                    <Border CornerRadius="4" Background="{DynamicResource SpotlightTileBrush}"/>
                                    <Border x:Name="ProgressFill" CornerRadius="4" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="ProgressShine" Width="120" HorizontalAlignment="Left" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                                <GradientStop Offset="0.5" Color="#66FFFFFF"/>
                                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform><TranslateTransform x:Name="ShineShift" X="-140"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <StackPanel x:Name="ProgressSteps" Margin="0,26,0,0"/>

                                <!-- 旧版本还在运行 -->
                                <Border x:Name="RunningPanel" Style="{StaticResource FlowRow}" Margin="0,18,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <TextBlock Text="共享速搜还开着" Style="{StaticResource FlowItemTitle}"/>
                                            <TextBlock Text="旧版本没有响应退出请求。强制关闭不会影响共享盘，最多丢失最近几秒的索引变化，下次启动会自动补上。" Style="{StaticResource FlowItemHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Content="取消" Height="32" Padding="12,0" Margin="0,0,8,0" Click="RunningCancel_Click" Focusable="False"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="强制关闭并继续" Height="32" Padding="14,0" Click="RunningForce_Click" Focusable="False"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 完成（安装和卸载共用） -->
                        <Grid x:Name="PageDone" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,28">
                                <Grid Width="76" Height="76" HorizontalAlignment="Left" Margin="0,0,0,26">
                                    <Ellipse x:Name="DoneCircle" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="DoneCircleScale" ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Path x:Name="DoneCheck" Data="M 22,39 L 33,50 L 55,27" Stroke="White" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" StrokeDashArray="12 12" StrokeDashOffset="12"/>
                                    <TextBlock x:Name="DoneError" Text="&#xE711;" Style="{StaticResource Icon}" FontSize="26" Foreground="White" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="DoneEyebrow" Text="完成" Style="{StaticResource FlowEyebrow}"/>
                                <TextBlock x:Name="DoneTitle" Text="装好了" Style="{StaticResource FlowTitle}" FontSize="30"/>
                                <TextBlock x:Name="DoneLead" Style="{StaticResource FlowLead}" MaxWidth="580" HorizontalAlignment="Left"/>
                                <StackPanel x:Name="DoneHotkey" Orientation="Horizontal" Margin="0,24,0,0">
                                    <TextBlock Text="以后在任何地方按" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Style="{StaticResource DemoKey}"><TextBlock Text="Ctrl" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource DemoKey}"><TextBlock Text="Alt" FontSize="12" FontWeight="SemiBold"/></Border>
                                    <Border Style="{StaticResource DemoKey}" MinWidth="76"><TextBlock Text="Space" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                                    <TextBlock Text="就能呼出" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 底栏：步骤圆点 + 按钮 -->
                    <Grid Grid.Row="2" Margin="52,0,32,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="上一步" Height="38" Padding="18,0" Margin="0,0,10,0" Click="BackButton_Click" Focusable="False"/>
                            <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Content="开始" Height="38" MinWidth="120" Padding="22,0" Click="NextButton_Click" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
