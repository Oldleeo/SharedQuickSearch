<Window x:Class="SharedQuickSearch.Setup.UpdatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在更新共享速搜" Icon="/Assets/共享速搜.ico" Style="{StaticResource FlowWindow}"
        Width="440" Height="176" WindowStartupLocation="Manual" ShowInTaskbar="True" Topmost="True" ShowActivated="False">
    <!-- 自动更新时的小卡片：出现在屏幕右下角，不抢焦点，装完自己消失 -->
    <Grid x:Name="Stage" Margin="16,10,16,22">
        <Border Style="{StaticResource FlowShadow}" CornerRadius="16"/>
        <Border Style="{StaticResource FlowPanel}" CornerRadius="16" Padding="20,18,22,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Top">
                    <Border CornerRadius="13" Background="{DynamicResource AccentSoftBrush}"/>
                    <Image Source="/Assets/共享速搜-icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText" Text="正在更新共享速搜" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    <Grid Height="4" Margin="0,14,0,0">
                        <Border CornerRadius="2" Background="{DynamicResource SpotlightTileBrush}"/>
                        <Border x:Name="Bar" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <Grid Margin="0,9,0,0">
                        <TextBlock x:Name="StatusText" Text="等待旧版本退出" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CloseButton" Content="关闭" HorizontalAlignment="Right" Height="26" Padding="12,0" FontSize="12" Visibility="Collapsed" Click="CloseButton_Click" Margin="0,-4,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
