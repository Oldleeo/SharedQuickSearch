<Window x:Class="SharedQuickSearch.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="共享速搜 · 隐私政策" Icon="Assets/共享速搜.ico" Width="680" Height="640" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WindowBase}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PolicyCard" TargetType="Border" BasedOn="{StaticResource SettingCard}"/>
        <Style x:Key="PolicyTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PolicyBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="隐私政策" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"/>
        </StackPanel>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" ToolTip="关闭"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,12">
            <StackPanel x:Name="Body">
                <TextBlock Text="一句话：所有东西都留在你的电脑上。" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="生效日期：2026-10-17  ·  发布者：老李Oldlee" Style="{StaticResource Caption}" Margin="0,6,0,20"/>

                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="隐私结论" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="共享速搜在本机运行，没有云端账号、广告、统计 SDK 或遥测，不向作者上传素材、文件名、路径、搜索内容或共享盘凭据。可选的全组缓存会向你指定的共享目录写入缩略图。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="本地处理的数据" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="软件读取你指定目录里的文件名、路径、扩展名、大小和修改时间来建立索引；预览时按需读取文件，或调用 Windows 系统缩略图组件。设置、索引和“最近使用”列表（最多 30 个文件路径、12 个关键词）保存在 %AppData%\Oldlee\共享速搜。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="共享盘与文件安全" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="索引和预览只读取文件，不会删除、移动、重命名或修改共享盘上的真实文件。“复制文件”只是把文件引用放进 Windows 剪贴板；把文件从搜索条拖出去时，软件只允许“复制”，目标位置得到的是副本，按 Shift 也不会变成移动。共享服务器的登录、权限和访问日志由 Windows 和你所在的组织管理。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="安装与卸载" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="安装只写当前用户范围：程序文件（默认 %LocalAppData%\Programs\共享速搜）、可选的开始菜单和桌面快捷方式、当前用户的卸载信息。不需要管理员权限。卸载删除这些内容和开机启动项；设置、索引和缩略图缓存默认保留，勾选后一并删除。安装和卸载都不访问共享盘。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="网络行为" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="网络用于访问已配置的共享盘、获取更新清单及签名、下载更新包，或由浏览器打开你点击的作者主页。更新请求不携带素材名称、路径或搜索内容，服务器仍能看到 IP 地址、程序版本等正常连接信息。自动更新不能关闭，可更换为受控的内网更新源。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="全组缓存与收集栏" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="全组缓存默认关闭。启用后，仅在指定位置的 .共享速搜缓存 里写缩略图；缓存读者可能看到这些图片，缓存不会自动继承每份原素材的访问限制，请先配置权限。收集栏路径保存在本机 %AppData%\Oldlee\共享速搜\tray.json，用于重启与更新后恢复。"/>
                </StackPanel></Border>
                <Border Style="{StaticResource PolicyCard}"><StackPanel>
                    <TextBlock Text="全局快捷键与开机启动" Style="{StaticResource PolicyTitle}"/>
                    <TextBlock Style="{StaticResource PolicyBody}" Text="普通快捷键只响应设定组合。双击 Ctrl 默认关闭，启用时安装全局键盘钩子，按键事件经过钩子但不记录、保存、发送或拦截。剪贴板预填仅在呼出时读取本机文字，可关闭。开机启动写入当前用户的 Windows Run 项，可随时关闭。"/>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Button Content="知道了" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="96" Height="36" Margin="0,0,24,0" Click="Close_Click" IsDefault="True" IsCancel="True"/>
        </Border>
    </Grid>
</Window>
