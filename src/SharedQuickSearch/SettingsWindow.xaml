<Window x:Class="SharedQuickSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharedQuickSearch"
        Title="共享速搜 · 设置" Icon="Assets/共享速搜.ico" Width="860" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource WindowBase}" Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- 主题卡片里的迷你窗口 -->
        <DataTemplate x:Key="MiniWindow">
            <Border Width="148" Height="96" CornerRadius="9" Background="{Binding Background}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="10"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border CornerRadius="5" Background="{Binding Surface}" Width="74" HorizontalAlignment="Center"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="5" Background="{Binding Surface}" Padding="6">
                            <UniformGrid Columns="3" Rows="2">
                                <Border CornerRadius="3" Background="{Binding Thumb}" Margin="2"/>
                                <Border CornerRadius="3" Background="{Binding Accent}" Margin="2"/>
                                <Border CornerRadius="3" Background="{Binding Thumb}" Margin="2"/>
                                <Border CornerRadius="3" Background="{Binding Thumb}" Margin="2"/>
                                <Border CornerRadius="3" Background="{Binding Thumb}" Margin="2"/>
                                <Border CornerRadius="3" Background="{Binding Thumb}" Margin="2"/>
                            </UniformGrid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="5" Background="{Binding Surface}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧导航 ============ -->
            <Grid Background="{DynamicResource WindowBackgroundBrush}">
                <StackPanel Margin="16,0,16,0">
                    <StackPanel Orientation="Horizontal" Height="52">
                        <Border Width="24" Height="24" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Center">
                            <Image RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><BitmapImage UriSource="Assets/共享速搜-icon.png" DecodePixelWidth="64"/></Image.Source></Image>
                        </Border>
                        <TextBlock Text="设置" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <RadioButton x:Name="NavIndex" Style="{StaticResource NavItem}" GroupName="Nav" Tag="0" Checked="Nav_Checked" Margin="0,10,0,2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,12,0"/><TextBlock Text="索引目录"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav" Tag="1" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE765;" Margin="0,0,12,0"/><TextBlock Text="启动与快捷键"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavThumbs" Style="{StaticResource NavItem}" GroupName="Nav" Tag="4" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" Margin="0,0,12,0"/><TextBlock Text="缩略图"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav" Tag="2" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Margin="0,0,12,0"/><TextBlock Text="外观"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav" Tag="3" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,12,0"/><TextBlock Text="关于"/></StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock x:Name="NavVersionText" Text="版本 1.8.0" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="28,0,0,18"/>
            </Grid>

            <!-- ============ 右侧内容 ============ -->
            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseWindow_Click" ToolTip="关闭"/>

                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,36,16">
                    <Grid x:Name="PagesHost">
                        <!-- 页面 0：索引目录 -->
                        <StackPanel x:Name="PageIndex">
                            <TextBlock Text="索引目录" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="添加需要搜索的共享盘或本地文件夹。索引保存在本机，搜索时不再访问共享盘。" Style="{StaticResource SettingHint}" Margin="0,6,0,20"/>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="要索引的目录" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="会扫描目录里的全部文件和子文件夹，可以直接粘贴 UNC 路径，例如 \\192.168.10.17\共享素材库" Style="{StaticResource SettingHint}"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="RootPathBox" local:Ui.Placeholder="\\服务器\共享文件夹" KeyDown="RootPathBox_KeyDown"/>
                                        <Button Grid.Column="2" Content="浏览…" Click="BrowseRoot_Click"/>
                                        <Button Grid.Column="4" Content="添加" Style="{StaticResource PrimaryButton}" Click="AddRoot_Click" Padding="18,0"/>
                                    </Grid>
                                    <ItemsControl x:Name="RootsList" ItemsSource="{Binding Roots}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,0,6,0" Height="40" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="#D69E2E" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                                        <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;" FontSize="10" Tag="{Binding}" Click="RemoveRoot_Click" ToolTip="移除"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RootsEmptyText" Text="还没有添加目录" Style="{StaticResource Caption}" Margin="2,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="排除目录" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="目录本身和它的全部子级都不会进入索引，例如回收站、临时文件夹。排除只清除索引记录，不会删除真实文件。" Style="{StaticResource SettingHint}"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExcludePathBox" local:Ui.Placeholder="\\服务器\共享文件夹\@Recycle" KeyDown="ExcludePathBox_KeyDown"/>
                                        <Button Grid.Column="2" Content="浏览…" Click="BrowseExclude_Click"/>
                                        <Button Grid.Column="4" Content="添加排除" Style="{StaticResource DangerButton}" Click="AddExclude_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="ExclusionsList" ItemsSource="{Binding Exclusions}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12,0,6,0" Height="40" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D8;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                                        <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE711;" FontSize="10" Tag="{Binding}" Click="RemoveExclude_Click" ToolTip="移除"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ExclusionsEmptyText" Text="没有排除目录" Style="{StaticResource Caption}" Margin="2,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 页面 1：启动与快捷键 -->
                        <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                            <TextBlock Text="启动与快捷键" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="让共享速搜常驻后台，随时用一个组合键呼出。" Style="{StaticResource SettingHint}" Margin="0,6,0,20"/>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="开机自动启动" Style="{StaticResource SettingTitle}"/><TextBlock Text="登录 Windows 后在后台运行，不弹出窗口。" Style="{StaticResource SettingHint}"/></StackPanel>
                                        <CheckBox x:Name="AutoStartCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="关闭窗口时驻留托盘" Style="{StaticResource SettingTitle}"/><TextBlock Text="点关闭按钮只是隐藏窗口，快捷键仍然可用。从托盘或菜单里选“退出”才会真正关闭。" Style="{StaticResource SettingHint}"/></StackPanel>
                                        <CheckBox x:Name="TrayCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="呼出时只显示搜索条" Style="{StaticResource SettingTitle}"/><TextBlock Text="按快捷键或打开软件时，只弹出一条搜索框，输入后展开缩略图。关掉则每次直接打开工作台（大网格 + 右侧详情）。搜索条右上角的按钮随时可以展开或收回。" Style="{StaticResource SettingHint}"/></StackPanel>
                                        <CheckBox x:Name="SpotlightCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="自动填入剪贴板里的 SKU" Style="{StaticResource SettingTitle}"/><TextBlock Text="刚复制了一个货号，呼出时直接帮你填好。只在本机读取剪贴板，同一段内容只填一次，不保存、不上传。" Style="{StaticResource SettingHint}"/></StackPanel>
                                        <CheckBox x:Name="ClipboardCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="全局呼出快捷键" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="点击下面的输入框，直接按下新的组合键。必须包含 Ctrl、Alt、Shift 或 Win 之一。" Style="{StaticResource SettingHint}"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" Height="40" FontSize="14" FontWeight="SemiBold" HorizontalContentAlignment="Center" Cursor="Hand"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                                        <Button Grid.Column="2" Content="恢复默认" Click="ResetHotkey_Click" Height="40"/>
                                    </Grid>
                                    <TextBlock x:Name="HotkeyHint" Text="保存设置后生效。" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 页面 2：外观 -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="选中即可预览，点“保存”后生效；点“取消”会恢复原来的主题。" Style="{StaticResource SettingHint}" Margin="0,6,0,20"/>
                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="主题" Style="{StaticResource SettingTitle}" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal" Margin="3,0,0,4">
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource ThemeCard}" GroupName="Theme" Tag="浅色" Checked="Theme_Checked">
                                            <ContentControl x:Name="ThemeLightPreview" ContentTemplate="{StaticResource MiniWindow}" IsHitTestVisible="False"/>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource ThemeCard}" GroupName="Theme" Tag="深色" Checked="Theme_Checked">
                                            <ContentControl x:Name="ThemeDarkPreview" ContentTemplate="{StaticResource MiniWindow}" IsHitTestVisible="False"/>
                                        </RadioButton>
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource ThemeCard}" GroupName="Theme" Tag="跟随系统" Checked="Theme_Checked">
                                            <Grid Width="148" Height="96">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ContentControl x:Name="ThemeSystemLeft" ContentTemplate="{StaticResource MiniWindow}" IsHitTestVisible="False" Grid.ColumnSpan="2"/>
                                                <Border Grid.Column="1" ClipToBounds="True">
                                                    <ContentControl x:Name="ThemeSystemRight" ContentTemplate="{StaticResource MiniWindow}" IsHitTestVisible="False" Margin="-74,0,0,0"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 页面 4：缩略图 -->
                        <StackPanel x:Name="PageThumbs" Visibility="Collapsed">
                            <TextBlock Text="缩略图" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="缩略图按“本机缓存 → Windows 缓存 → 文件内嵌预览 → 现场生成”逐层查找。看过一次的文件，下次直接从本机读，不再访问共享盘。" Style="{StaticResource SettingHint}" Margin="0,6,0,20"/>

                            <Border Style="{StaticResource SettingCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="空闲时提前生成缩略图" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="按修改时间从新到旧，为图片、PSD、AI、PDF 提前生成并存到本机，你在浏览时会自动暂停。PSD、AI 和带内嵌预览的 JPG 只读文件开头；超过 4 MB 又没有内嵌预览的文件不预热，看到时再生成。" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="PrefetchCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="本机缓存" Style="{StaticResource SettingTitle}"/>
                                            <TextBlock x:Name="CacheSizeText" Text="正在统计…" Style="{StaticResource SettingHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CacheLimitBox" Grid.Column="1" Width="130" VerticalAlignment="Center" ToolTip="缓存上限，超出后自动删除最久没用的">
                                            <ComboBoxItem Content="上限 512 MB" Tag="512"/>
                                            <ComboBoxItem Content="上限 1 GB" Tag="1024"/>
                                            <ComboBoxItem Content="上限 2 GB" Tag="2048"/>
                                            <ComboBoxItem Content="上限 5 GB" Tag="5120"/>
                                            <ComboBoxItem Content="上限 10 GB" Tag="10240"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="CacheFolderText" Style="{StaticResource SelectableText}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                        <Button Grid.Column="1" Content="打开文件夹" Click="OpenCacheFolder_Click"/>
                                        <Button Grid.Column="3" Content="清空缓存" Style="{StaticResource DangerButton}" Click="ClearCache_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="本次运行统计" Style="{StaticResource SettingTitle}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource SmallIconButton}" Content="&#xE72C;" Click="RefreshStats_Click" ToolTip="刷新"/>
                                    </Grid>
                                    <UniformGrid Columns="3" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,0,12"><TextBlock x:Name="StatDisk" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="本机缓存命中" Style="{StaticResource Caption}"/></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock x:Name="StatWindows" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Windows 缓存命中" Style="{StaticResource Caption}"/></StackPanel>
                                        <StackPanel Margin="0,0,0,12"><TextBlock x:Name="StatEmbedded" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="文件内嵌预览" Style="{StaticResource Caption}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="StatGenerated" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="现场生成" Style="{StaticResource Caption}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="StatAverage" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="平均耗时（不含内存命中）" Style="{StaticResource Caption}"/></StackPanel>
                                        <StackPanel><TextBlock x:Name="StatPrefetch" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="后台预热进度" Style="{StaticResource Caption}"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 页面 3：关于 -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="72" Height="72" CornerRadius="18" ClipToBounds="True">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#000000"/></Border.Effect>
                                    <Image RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><BitmapImage UriSource="Assets/共享速搜-icon.png" DecodePixelWidth="160"/></Image.Source></Image>
                                </Border>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="共享速搜" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="VersionText" Text="版本 1.8.0" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="共享盘素材的本机索引、搜索和预览工具。为按 SKU 找图、找源文件的日常场景而做。" Style="{StaticResource SettingHint}" Margin="0,18,0,20"/>

                            <Border Style="{StaticResource SettingCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="44" Height="44" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1">
                                        <Ellipse.Fill><ImageBrush Stretch="UniformToFill"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/老李Oldlee-头像.png" DecodePixelWidth="120"/></ImageBrush.ImageSource></ImageBrush></Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="@老李Oldlee" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="作者与发布者" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="Author_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="作者主页"/><TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="8,0,0,0"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="只在本机运行" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="不上传文件名、路径、缩略图或搜索内容，也不会修改、移动或删除共享盘上的任何文件。" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="隐私政策" Click="Privacy_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="使用教学" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="5 张动画卡片：呼出、搜索写法、拖出复制、空格预览缩放、回车和工作台。大约一分钟看完。" Style="{StaticResource SettingHint}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="查看教学" Click="Tutorial_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Button Content="取消" Click="Cancel_Click" Width="92" Height="36" IsCancel="True"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="92" Height="36" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
