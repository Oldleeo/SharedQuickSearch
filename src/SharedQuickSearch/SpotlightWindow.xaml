<Window x:Class="SharedQuickSearch.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharedQuickSearch"
        Title="共享速搜" Width="1000" Height="740"
        Style="{StaticResource WindowBase}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

        <!-- 分类胶囊（选中为实心强调色） -->
        <Style x:Key="CategoryChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="14" Background="{DynamicResource HoverOverlayBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"/>
                            <Border x:Name="On" CornerRadius="14" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="Count" Text="{Binding CountText}" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Margin="6,1,0,0" Opacity="0.7" Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}"/></Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Count}" Value="0"><Setter TargetName="Label" Property="Opacity" Value="0.45"/></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 识别出的条件：浅强调色 + × -->
        <Style x:Key="TokenChipButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource SelectedStrokeBrush}" BorderThickness="1" Padding="11,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="8" Margin="7,1,0,0" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 一张卡片 -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:TileItem}">
            <Grid x:Name="Tile" Margin="7,6,7,0" Background="Transparent" Cursor="Hand" Tag="{Binding}"
                  MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                  MouseRightButtonUp="Tile_MouseRightButtonUp" MouseDown="Tile_MouseDown" Loaded="Tile_Loaded" Unloaded="Tile_Unloaded">
                <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="HoverShadow" CornerRadius="11" Background="{DynamicResource SpotlightTileBrush}" Opacity="0" Visibility="Hidden">
                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance"/></Border.Effect>
                </Border>
                <Border x:Name="Thumb" CornerRadius="11" Background="{DynamicResource SpotlightTileBrush}">
                    <Grid>
                        <TextBlock x:Name="Glyph" Text="{Binding Entry.IconGlyph}" Style="{StaticResource Icon}" FontSize="34" Foreground="{Binding Entry.TypeBrush}" Opacity="0.85"/>
                        <Image x:Name="ThumbImage" Source="{Binding Entry.Thumbnail, NotifyOnTargetUpdated=True}" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                        <Border x:Name="Badge" CornerRadius="5" Background="{Binding Entry.TypeBrush}" Padding="6,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Entry.ExtensionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource SpotlightPanelBrush}" BorderThickness="2" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="9" Foreground="White"/>
                        </Border>
                        <Border x:Name="DragHint" Height="26" CornerRadius="8" Margin="8" VerticalAlignment="Bottom" Background="#C815171C" Opacity="0" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="拖出即复制" FontSize="11" FontWeight="Medium" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <!-- 已放进收集栏：右下角一个小标记 -->
                        <Border x:Name="Collected" Width="22" Height="22" CornerRadius="11" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource SpotlightPanelBrush}" BorderThickness="2"
                                Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></Border.RenderTransform>
                            <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="9.5" Foreground="White"/>
                        </Border>
                        <!-- 复制成功时闪一下 -->
                        <Border x:Name="Flash" CornerRadius="11" Background="#D92457E6" Opacity="0" IsHitTestVisible="False">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="30" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="Ring" CornerRadius="13" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>

                <TextBlock Grid.Row="1" Margin="2,8,2,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding Pre, Mode=OneWay}"/><Run Text="{Binding Hit, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text="{Binding Post, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Row="2" Margin="2,2,2,0" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Meta}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollected}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.34">
                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.34">
                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.4" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetName="Collected" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.4" Duration="0:0:0.14"/>
                    </Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Entry.HasThumbnail}" Value="True"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Entry.IsDirectory}" Value="True"><Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverShadow" Property="Visibility" Value="Visible"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                        <DoubleAnimation Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="DragHint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" BeginTime="0:0:0.25"/>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                        <DoubleAnimation Storyboard.TargetName="HoverShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetName="DragHint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Stage" Margin="20,16,20,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="StageScale"/>
                <TranslateTransform x:Name="StageShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- 阴影单独一层：高度跟随展开动画 -->
        <Border x:Name="PanelShadow" Height="64" VerticalAlignment="Top" CornerRadius="18" Background="{DynamicResource SpotlightPanelBrush}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.3" Color="#000000" RenderingBias="Performance"/></Border.Effect>
        </Border>

        <!-- 面板按完整高度排好版，展开 / 收起只改裁剪区域：不触发重新排版，动画稳定满帧。
             工作台模式是同一块面板放大，加一栏详情，不是另一个窗口。 -->
        <Grid x:Name="PanelRoot" Width="960" Height="680" VerticalAlignment="Top">
            <Grid.Clip><RectangleGeometry x:Name="PanelClip" Rect="0,0,960,64" RadiusX="18" RadiusY="18"/></Grid.Clip>
            <Border Background="{DynamicResource SpotlightPanelBrush}" BorderBrush="{DynamicResource SpotlightStrokeBrush}" BorderThickness="1" CornerRadius="18"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <!-- 搜索框（工作台模式下按住空白处可以拖动窗口） -->
                <Grid Grid.Row="0" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderDrag" Grid.ColumnSpan="7" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="19" Foreground="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索 SKU、文件名或拼音首字母" FontSize="21" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}" FontSize="21" FontWeight="Medium" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" PreviewTextInput="SearchBox_PreviewTextInput"/>
                    <TextBlock x:Name="StatsText" Grid.Column="2" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,14,0" IsHitTestVisible="False"/>
                    <Border Grid.Column="3" Width="1" Height="26" Background="{DynamicResource StrokeBrush}" IsHitTestVisible="False"/>
                    <StackPanel x:Name="WorkbenchButtons" Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed">
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE72C;" FontSize="13" Focusable="False"
                                Click="RefreshButton_Click" ToolTip="刷新索引（完整扫描一次共享盘）"/>
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE706;" FontSize="13" Focusable="False"
                                Click="ThemeButton_Click" ToolTip="切换主题"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE713;" FontSize="13" Focusable="False"
                                Click="SettingsButton_Click" ToolTip="设置 (Ctrl+,)"/>
                    </StackPanel>
                    <Button x:Name="ExpandButton" Grid.Column="5" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="2,0,0,0" Content="&#xE740;" FontSize="13"
                            Click="ExpandButton_Click" ToolTip="展开为工作台 (Ctrl+Shift+Enter)" Focusable="False"/>
                    <Button x:Name="CloseButton" Grid.Column="6" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="2,0,0,0" Content="&#xE8BB;" FontSize="11"
                            Click="CloseButton_Click" ToolTip="关闭 (Esc)" Focusable="False" Visibility="Collapsed"/>
                </Grid>

                <!-- 分类 + 识别出的条件 + 排序 -->
                <Grid Grid.Row="1" Margin="18,0,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Height="1" VerticalAlignment="Top" Margin="-18,0,-14,0" Background="{DynamicResource StrokeBrush}" Grid.ColumnSpan="2"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="ChipsList" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource CategoryChip}" Click="Chip_Click"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="TokensList" Focusable="False" Margin="6,0,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource TokenChipButton}" Click="Token_Click" ToolTip="点击移除这个条件"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button x:Name="SortButton" Grid.Column="1" Style="{StaticResource GhostButton}" Height="28" MinHeight="0" Padding="10,0" FontSize="12" Focusable="False"
                            Click="SortButton_Click" Content="相关度"/>
                </Grid>

                <!-- 缩略图网格（按行虚拟化 + 平滑滚动）+ 工作台模式的详情栏 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <ItemsControl x:Name="Rows" Focusable="False" Padding="11,4,11,12"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer x:Name="PART_Scroll" Focusable="False" CanContentScroll="True" Padding="{TemplateBinding Padding}"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="Scroll_PreviewMouseWheel" ScrollChanged="Scroll_ScrollChanged">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TileRow}">
                                    <ItemsControl ItemsSource="{Binding Items}" Height="208" Focusable="False" ItemTemplate="{StaticResource TileTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=local:SpotlightWindow}}"/>
                                        </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SectionTitle" Text="最近使用" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" Margin="20,-2,0,0"
                                   VerticalAlignment="Top" Visibility="Collapsed"/>

                        <StackPanel x:Name="NoResults" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,34,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="NoResultsTitle" Text="没有找到" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NoResultsHint" Text="试试只输入 SKU 主体，或用拼音首字母" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            <Button x:Name="NoResultsButton" Style="{StaticResource PrimaryButton}" Content="添加共享盘目录" Margin="0,18,0,0" HorizontalAlignment="Center"
                                    Padding="18,0" Height="36" Click="NoResultsButton_Click" Visibility="Collapsed" Focusable="False"/>
                        </StackPanel>

                        <!-- 底部渐隐，提示还能往下滚 -->
                        <Border Height="40" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="Transparent"/>
                                    <GradientStop Offset="1" Color="{DynamicResource SpotlightPanelColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- 详情栏：和网格同一套卡片、字体、间距 -->
                    <Grid x:Name="DetailPane" Grid.Column="1" Visibility="Collapsed">
                        <Border Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,0"/>
                        <Grid Margin="18,10,18,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="180"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="DetailPreview" CornerRadius="14" Background="{DynamicResource SpotlightTileBrush}" Cursor="Hand"
                                    MouseLeftButtonDown="DetailPreview_MouseLeftButtonDown" ToolTip="点击放大预览（空格）">
                                <Grid>
                                    <TextBlock x:Name="DetailGlyph" Style="{StaticResource Icon}" FontSize="46" Opacity="0.85"/>
                                    <Image x:Name="DetailImage" Margin="14" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Border x:Name="DetailBadge" CornerRadius="5" Padding="6,2" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                                        <TextBlock x:Name="DetailBadgeText" FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="DetailEmpty" Text="选中一个文件查看详情" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="DetailName" Grid.Row="1" Margin="2,16,2,0" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>

                            <Grid x:Name="DetailMeta" Grid.Row="2" Margin="2,12,2,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="类型" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="DetailType" Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="DetailDimsLabel" Grid.Row="1" Text="尺寸" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="DetailDims" Grid.Row="1" Grid.Column="1" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="2" Text="大小" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="DetailSize" Grid.Row="2" Grid.Column="1" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="3" Text="修改" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock x:Name="DetailModified" Grid.Row="3" Grid.Column="1" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,7"/>
                                <TextBlock Grid.Row="4" Text="位置" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="DetailPath" Grid.Row="4" Grid.Column="1" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid x:Name="DetailActions" Grid.Row="3" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button x:Name="DetailOpenButton" Style="{StaticResource PrimaryButton}" Height="34" Content="打开" Click="DetailOpen_Click" Focusable="False" ToolTip="双击卡片 / Ctrl+Enter"/>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="34" Content="所在位置" Click="DetailReveal_Click" Focusable="False" ToolTip="Enter"/>
                                <Button Grid.Row="2" Style="{StaticResource GhostButton}" Height="34" Content="复制文件" Click="DetailCopy_Click" Focusable="False" ToolTip="Ctrl+Shift+C"/>
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource GhostButton}" Height="34" Content="复制路径" Click="DetailCopyPath_Click" Focusable="False" ToolTip="Ctrl+C"/>
                            </Grid>

                            <Button x:Name="DetailSkuButton" Grid.Row="4" Style="{StaticResource GhostButton}" Height="32" Margin="0,8,0,0" FontSize="12" Focusable="False"
                                    Click="DetailSku_Click" Visibility="Collapsed" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 底栏：选中的文件（工作台模式下换成索引状态）+ 操作提示 / 操作反馈 -->
                <Grid Grid.Row="3" Margin="18,0,18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Height="1" VerticalAlignment="Top" Margin="-18,0" Background="{DynamicResource StrokeBrush}" Grid.ColumnSpan="3"/>
                    <Border x:Name="FooterThumbBox" Width="32" Height="32" CornerRadius="7" Background="{DynamicResource SpotlightTileBrush}" VerticalAlignment="Center">
                        <Image x:Name="FooterThumb" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel x:Name="FooterInfo" Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterName" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FooterPath" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="FooterIndex" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed">
                        <Ellipse x:Name="FooterIndexDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FooterIndexText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel x:Name="FooterHints" Orientation="Horizontal">
                            <Border Style="{StaticResource Kbd}"><TextBlock Text="拖出" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <TextBlock Text="复制到任意位置" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Kbd}"><TextBlock Text="空格" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <TextBlock Text="预览" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Kbd}"><TextBlock Text="↵" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <TextBlock Text="所在位置" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Kbd}"><TextBlock Text="双击" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <TextBlock Text="打开" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Kbd}"><TextBlock Text="中键" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            <TextBlock Text="收集" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="FooterStatus" Orientation="Horizontal" Opacity="0" Visibility="Collapsed" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="FooterStatusText" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 搜索条收起、只留收集栏时：盖住下面的分类和网格，只露出搜索框和收集栏 -->
                <Border x:Name="CollapsedCover" Grid.Row="1" Grid.RowSpan="3" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Border.Background><SolidColorBrush Color="{DynamicResource SpotlightPanelColor}"/></Border.Background>
                </Border>
            </Grid>

            <!-- 收集栏：中键点过的文件跨多次搜索攒在这里，最后一起复制或拖出 -->
            <Border x:Name="Tray" HorizontalAlignment="Center" VerticalAlignment="Top" Height="92" CornerRadius="16"
                    Background="{DynamicResource SpotlightPanelBrush}" BorderBrush="{DynamicResource SpotlightStrokeBrush}" BorderThickness="1"
                    Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform><TranslateTransform x:Name="TrayShift"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance"/></Border.Effect>
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="44">
                        <TextBlock x:Name="TrayCount" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Left"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform x:Name="TrayCountScale"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="已收集" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="TrayScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="TrayScroll_PreviewMouseWheel" VerticalAlignment="Center">
                        <ItemsControl x:Name="TrayList" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:TrayItem}">
                                    <Grid x:Name="Card" Width="70" Height="70" Background="Transparent" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Tip}"
                                          ClipToBounds="False" Loaded="TrayCard_Loaded"
                                          MouseLeftButtonDown="TrayCard_MouseLeftButtonDown" MouseMove="TrayCard_MouseMove" MouseLeftButtonUp="TrayCard_MouseLeftButtonUp"
                                          MouseDown="TrayCard_MouseDown" MouseRightButtonUp="TrayCard_MouseRightButtonUp">
                                        <Border x:Name="CardBody" Width="62" Height="62" CornerRadius="11" Background="{DynamicResource SpotlightTileBrush}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                                            <Grid>
                                                <TextBlock x:Name="CardGlyph" Text="{Binding Entry.IconGlyph}" Style="{StaticResource Icon}" FontSize="22" Foreground="{Binding Entry.TypeBrush}"/>
                                                <Image Source="{Binding Entry.Thumbnail}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border CornerRadius="4" Background="{Binding Entry.TypeBrush}" Padding="4,1" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        x:Name="CardBadge">
                                                    <TextBlock Text="{Binding Entry.ExtensionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="7.5" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border x:Name="CardRemove" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                                Background="{DynamicResource TextPrimaryBrush}" Opacity="0" Cursor="Hand" MouseLeftButtonDown="TrayCardRemove_MouseLeftButtonDown"
                                                ToolTip="移出收集栏（或中键点卡片）">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="7.5" Foreground="{DynamicResource SpotlightPanelBrush}"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Entry.HasThumbnail}" Value="True"><Setter TargetName="CardGlyph" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Entry.IsDirectory}" Value="True"><Setter TargetName="CardBadge" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardRemove" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardRemove" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border x:Name="TrayDrag" Height="40" CornerRadius="10" Padding="13,0" Margin="0,0,8,0" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource SelectedStrokeBrush}" BorderThickness="1" Cursor="Hand"
                                MouseLeftButtonDown="TrayDrag_MouseLeftButtonDown" MouseMove="TrayDrag_MouseMove" MouseLeftButtonUp="TrayDrag_MouseLeftButtonUp"
                                ToolTip="按住拖到任意位置：把收集栏里的文件全部复制过去">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE76F;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="拖出全部" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="TrayCopyButton" Style="{StaticResource PrimaryButton}" Height="40" Padding="15,0" Margin="0,0,4,0" Focusable="False"
                                Click="TrayCopy_Click" Content="复制全部" ToolTip="复制收集栏里的全部文件，到别处直接粘贴"/>
                        <Button Style="{StaticResource IconButton}" Width="36" Height="36" Content="&#xE74D;" FontSize="13" Focusable="False"
                                Click="TrayClear_Click" ToolTip="清空收集栏（Ctrl+Z 撤销）"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 飞向收集栏的卡片在这一层画，不挡鼠标 -->
            <Canvas x:Name="FlyLayer" IsHitTestVisible="False" ClipToBounds="False"/>

            <!-- 工作台模式：右下角拖动改大小 -->
            <Thumb x:Name="ResizeGrip" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Cursor="SizeNWSE"
                   DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted" Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 14,4 L 4,14 M 14,9 L 9,14" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!-- 空格预览（共享元素转场：缩略图从网格里飞出来放大；滚轮缩放、拖动查看细节） -->
            <Grid x:Name="Look" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="Look_MouseLeftButtonDown" PreviewMouseWheel="Look_MouseWheel">
                <Border x:Name="LookBackdrop" Background="{DynamicResource SpotlightPanelBrush}" CornerRadius="18" Opacity="0"/>
                <Canvas x:Name="LookCanvas" ClipToBounds="True">
                    <Image x:Name="LookImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0,0"
                           MouseLeftButtonDown="LookImage_MouseLeftButtonDown" MouseMove="LookImage_MouseMove" MouseLeftButtonUp="LookImage_MouseLeftButtonUp"/>
                </Canvas>
                <Grid x:Name="LookChrome" VerticalAlignment="Bottom" Height="64" Margin="24,0,24,6" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LookName" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="LookMeta" FontSize="11.5" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Kbd}" Margin="12,0,16,0" MinWidth="58">
                        <TextBlock x:Name="LookZoomText" Text="适应" FontSize="10.5" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="滚轮" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                        <TextBlock Text="缩放" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="← →" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                        <TextBlock Text="切换" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="空格" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                        <TextBlock Text="关闭" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,14,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="↵" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                        <TextBlock Text="所在位置" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
