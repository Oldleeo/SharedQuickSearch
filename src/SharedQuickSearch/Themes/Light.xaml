<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色：暖调石墨中性色 + 一个蓝紫强调色。所有界面颜色只从这里取。 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#F0F1F4"/>
    <SolidColorBrush x:Key="SearchBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlAltBrush" Color="#ECEDF1"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F2F5"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0B0F1A2E"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#140F1A2E"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#EDF2FD"/>
    <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#C6D4F7"/>

    <SolidColorBrush x:Key="StrokeBrush" Color="#E4E6EB"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#D2D5DC"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14161B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5D6372"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#959BA8"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2457E6"/>
    <SolidColorBrush x:Key="AccentHoverOverlayBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF0FD"/>
    <SolidColorBrush x:Key="AccentRingBrush" Color="#402457E6"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#22A55B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E39A1C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D93A3A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDEDED"/>

    <SolidColorBrush x:Key="ToastBrush" Color="#F0181A20"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5C9D1"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9BA1AD"/>
    <SolidColorBrush x:Key="KeycapBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="KeycapStrokeBrush" Color="#DADDE3"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#CDD1D8"/>

    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E81123"/>

    <!-- 聚光面板 -->
    <Color x:Key="SpotlightPanelColor">#FAFAFC</Color>
    <SolidColorBrush x:Key="SpotlightPanelBrush" Color="#F5FAFAFC"/>
    <SolidColorBrush x:Key="SpotlightStrokeBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="SpotlightTileBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="SpotlightScrimBrush" Color="#C8F4F5F8"/>
</ResourceDictionary>
